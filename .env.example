# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings > API). Never commit .env — it's already in .gitignore.

# ---------------------------------------------------------------------------
# Client-exposed (safe to ship to the browser).
# Vite only inlines variables prefixed VITE_ into the client bundle, so this
# prefix is what makes a variable public — never put a secret behind it.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps Platform (Maps JavaScript API + Places API) — powers the
# Lalamove checkout address picker (src/components/storefront/
# LalamoveAddressPicker.tsx). From Google Cloud Console > APIs & Services >
# Credentials. Restrict it there by HTTP referrer (your domain(s) +
# localhost) rather than leaving it unrestricted.
VITE_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Server-only. No VITE_ prefix, so Vite never bundles these into client code.
# Used by src/lib/supabase/server.ts (per-request, respects RLS).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Server-only, HIGH PRIVILEGE. Bypasses Row Level Security entirely.
# Used only by src/lib/supabase/admin.ts. Never expose this to the browser,
# never prefix it with VITE_, never log it.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---------------------------------------------------------------------------
# Reserved for future steps — not required yet, listed here so the shape of
# the config is visible up front.
# ---------------------------------------------------------------------------

# Xendit secret keys (server-only, never prefix with VITE_). Two keys scoped
# by permission: WRITE creates payments/invoices, READ checks their status.
# From the Xendit Dashboard > Settings > API Keys — use test/development keys
# until the real payment integration goes live.
XENDIT_SECRET_KEY_WRITE=
XENDIT_SECRET_KEY_READ=

# Xendit Dashboard > Settings > Webhooks > Verification Token. Compared
# against the x-callback-token header on every inbound webhook so a forged
# request can't fake a "payment confirmed" event.
XENDIT_WEBHOOK_VERIFICATION_TOKEN=

# PayPal (developer.paypal.com > Apps & Credentials) — used for non-
# Philippines online checkouts, which Xendit's account can't charge in
# their real currency (see lib/paypal/client.ts). PAYPAL_ENVIRONMENT
# controls which API host every call hits: unset or anything other than
# 'live' means Sandbox (test money, safe to leave as the default).
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the same app's Sandbox/Live Webhooks setup (added after deploying —
# the webhook URL has to exist first). Needed to verify an inbound webhook
# actually came from PayPal (see api/webhooks/paypal.ts).
PAYPAL_WEBHOOK_ID=

# Resend (resend.com) — sends every automated/notification email this app
# sends. From your Resend dashboard's API Keys page. RESEND_FROM_EMAIL (and
# every override below) must be an address on a domain you've verified with
# Resend (e.g. reviews@yourdomain.com) — an unverified domain's sends fail
# outright. RESEND_FROM_EMAIL is the default/fallback sender; each
# _ABANDONED_CART/_WELCOME/_REVIEWS/_ORDERS/_BIRTHDAY override below is
# optional — set one only if that specific automation should send from a
# different address than the default.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_EMAIL_ABANDONED_CART=
RESEND_FROM_EMAIL_WELCOME=
RESEND_FROM_EMAIL_REVIEWS=
RESEND_FROM_EMAIL_ORDERS=
RESEND_FROM_EMAIL_BIRTHDAY=

# Where the "new order" notification email goes when a storefront order is
# placed. Optional — if unset, that notification is silently skipped (a
# missing address shouldn't ever block checkout).
STORE_OWNER_EMAIL=

# Order-emails thread (Admin > Orders > an order > Emails) — lets a
# customer's reply route back to the right order. Both optional: unset
# means sendOrderEmail() still sends fine, just without a Reply-To, and the
# inbound webhook (routes/api/webhooks/resend-inbound.ts) 401s until
# RESEND_WEBHOOK_SECRET is set. See that file's header comment for the full
# Resend-dashboard + DNS setup these require — nothing here configures that
# on its own.
# ORDER_EMAIL_INBOUND_DOMAIN — a dedicated inbound subdomain you've added in
# Resend (e.g. reply.yourdomain.com), NOT your root sending domain.
ORDER_EMAIL_INBOUND_DOMAIN=
# RESEND_WEBHOOK_SECRET — the signing secret (whsec_...) Resend gives you
# when you create the email.received webhook endpoint.
RESEND_WEBHOOK_SECRET=
# RESEND_RECEIVING_API_KEY — a separate Resend API key with Full access
# (RESEND_API_KEY above is Sending-only in most setups, which can't read
# received emails). Kept distinct so the key used for every outbound send
# stays scoped to Sending only.
RESEND_RECEIVING_API_KEY=

# Public base URL of the storefront (no trailing slash), e.g.
# https://spadesph.com. Used to build the review-request link — the cron job
# has no incoming request to derive an origin from, unlike a normal page load.
SITE_URL=

# Shared secret the two Vercel-scheduled cron routes (review-requests,
# sync-channels-daily) check for in the `Authorization: Bearer <value>`
# header before running. Vercel automatically sends this exact env var as
# that header for crons defined in vercel.json, so don't rename it and don't
# reuse it for externally-triggered crons (see CRON_JOB_ORG_SECRET below) —
# rotating it only affects Vercel's own cron calls. Generate a long random
# string (e.g. `openssl rand -hex 32`). Without this set, the endpoints
# reject every request rather than running unauthenticated.
CRON_SECRET=

# Separate shared secret for cron routes triggered by an external scheduler
# instead of vercel.json (currently sync-channels-pull-orders, called by
# cron-job.org every 5 minutes). Kept independent from CRON_SECRET so
# rotating one never breaks the other — you must manually update the
# Authorization header value configured in cron-job.org's dashboard whenever
# you change this. Generate a long random string (e.g. `openssl rand -hex
# 32`).
CRON_JOB_ORG_SECRET=

# TikTok Shop Partner Center app credentials (see
# src/server/integrations/marketplaces/tiktok-shop). Per-shop OAuth tokens
# themselves go in the `marketplace_connections` table, not here — these two
# are just the app-level key/secret used to sign every API request and
# complete the OAuth token exchange. NOTE: marketplace_connections currently
# stores tokens as plain text (see that table's original migration comment
# about encrypting them at rest, which hasn't been implemented) — treat this
# table as sensitive.
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=

# Shopee Open Platform app credentials (see
# src/server/integrations/marketplaces/shopee). SHOPEE_ENV is "sandbox" or
# "live" — controls which base URL the adapter signs requests against.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ENV=sandbox

# Meta (Facebook) Pixel ID, from Meta Events Manager > Data Sources > your
# pixel ("Dataset ID" on that page). Client-exposed (VITE_ prefix) since the
# Pixel ID is not a secret — it's meant to be visible in the page source.
# One deployment now serves three brands (Spades/Ysrael/Aspire 365, see
# server/storefront/domain.ts) — each needs its own pixel.
VITE_FB_PIXEL_ID=
VITE_FB_PIXEL_ID_YSRAEL=
VITE_FB_PIXEL_ID_ASPIRE365=

# Lalamove (same-day courier, sandbox/production) — see
# src/lib/lalamove/client.ts. LALAMOVE_ENV picks the base URL the same way
# SHOPEE_ENV does ("sandbox" or "live"). LALAMOVE_MARKET is the required
# `Market` header Lalamove expects on every request (e.g. "PH").
# LALAMOVE_PICKUP_* is the fixed warehouse Lalamove quotes distance from —
# the lat/lng were geocoded once from the address below and may need a
# small manual nudge (drag the pin in the same picker component used at
# checkout, then update these two values) if deliveries seem off.
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_ENV=sandbox
LALAMOVE_MARKET=PH
LALAMOVE_PICKUP_ADDRESS=
LALAMOVE_PICKUP_LAT=
LALAMOVE_PICKUP_LNG=

# Lazada credentials — added once that adapter is built (see the stub file
# in src/server/integrations/marketplaces/lazada).
# LAZADA_APP_KEY=
# LAZADA_APP_SECRET=

# ShipMate / ProfitMate service-to-service API keys — added when those
# integrations are built.
# SHIPMATE_API_KEY=
# PROFITMATE_API_KEY=
